# ─────────────────────────────────────────────────────────────
# SCF Nexus — Environment Variables Template
# Copy this file to ".env" and fill in your values.
# NEVER commit the real ".env" file to version control.
# ─────────────────────────────────────────────────────────────

# General
APP_NAME=Supply Chain Finance Core API
ENV=production

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY

# Database
# SQLite (local dev / simple demo):
DATABASE_URL=sqlite:///./supply_chain_finance.db
# PostgreSQL (Render free DB — replace with your Render DB URL):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS — comma-separated list of allowed frontend origins
# Use * for public APIs / hackathon demos (less secure)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Token expiry (minutes) — default 24 hours
ACCESS_TOKEN_EXPIRE_MINUTES=1440
